{
  "name": "book-shelf-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint && tsc --noEmit && npm run check:isolation && npm run check:auth-schema",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:isolation": "tsx scripts/check-isolation.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply book-shelf-manager --local",
    "db:migrate:remote": "wrangler d1 migrations apply book-shelf-manager --remote",
    "db:seed": "tsx scripts/seed.ts",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dev": "opennextjs-cloudflare build && wrangler dev",
    "cf:preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "postinstall": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:auth-schema": "tsx scripts/check-auth-schema.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.1",
    "@opennextjs/cloudflare": "1.20.2",
    "better-auth": "1.7.1",
    "better-auth-cloudflare": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.550.0",
    "next": "15.5.23",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
