{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "book-shelf-manager",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // The built single page app. Requests under /api/ go to the Worker instead.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "book-shelf-manager",
      // Printed by `npx wrangler d1 create book-shelf-manager`, and listed
      // again by `npx wrangler d1 list`. Not a secret: reaching the database
      // still takes the account's API token.
      "database_id": "c1d21a2d-649d-4630-8588-d8ef382e9898",
      "migrations_dir": "migrations",
    },
  ],

  // Sender address for password reset mail. The API key itself is a secret:
  // `npx wrangler secret put RESEND_API_KEY`
  "vars": {
    "MAIL_FROM": "藏書庫存管理 <onboarding@resend.dev>",
  },

  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "book-shelf-uploads",
    },
  ],
}
